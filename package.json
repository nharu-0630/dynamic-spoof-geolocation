{
  "name": "dynamic-spoof-geolocation",
  "version": "2.0.0",
  "description": "Chrome extension that spoofs the Geolocation API, with a Tokaido Shinkansen timetable / route simulator",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "data:route": "node scripts/build-route-data.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.28",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  }
}
